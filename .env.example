# Copy to .env and fill locally. Do not commit real secrets.

MAIL_AGENT_MODE=read_only
# Optional: defaults are derived from the repository root.
# MAIL_AGENT_PROJECT_DIR=D:\projects\mail-agent-mvp
# MAIL_AGENT_DB_PATH=D:\projects\mail-agent-mvp\data\mail-agent.sqlite3
MAIL_BACKEND=gmail_api

GMAIL_ACCOUNT_EMAIL=your.email@example.com
# GMAIL_CREDENTIALS_PATH=D:\projects\mail-agent-mvp\secrets\gmail-credentials.json
# GMAIL_TOKEN_PATH=D:\projects\mail-agent-mvp\secrets\gmail-token.json

IMAP_PROVIDER=gmail
IMAP_ACCOUNT_EMAIL=your.email@example.com
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TIMEOUT_SECONDS=15
IMAP_USERNAME=your.email@example.com
IMAP_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
